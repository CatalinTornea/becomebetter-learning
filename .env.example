# Database
DATABASE_URL="postgresql://user:password@localhost:5432/adaptiveops"

# JWT (use at least 32 random characters in production)
JWT_SECRET="your-secret-key-here-must-be-32-chars-min"
JWT_REFRESH_SECRET="your-refresh-secret-here-32-chars-min"

# API
API_PORT=4000
PORT=4000

# Frontend URL(s) allowed to call the API (comma-separated)
FRONTEND_URL="http://localhost:3000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"

# AI - Groq API (Free tier available)
# Get API key from: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"

# Seed (development only)
# SEED_ADMIN_PASSWORD="choose-a-strong-password"
# SEED_STUDENT_PASSWORD="choose-a-strong-password"
# ALLOW_SEED=true
