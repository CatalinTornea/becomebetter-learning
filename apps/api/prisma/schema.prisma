generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  COACH
  ADMIN
}

// Removed CourseLevel and DifficultyLevel enums per request

enum ScenarioVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  fullName           String
  passwordHash       String
  role               UserRole            @default(STUDENT)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  scenarioResponses  ScenarioResponse[]
  ownedScenarios     Scenario[]
}

model Course {
  id                   String     @id @default(uuid())
  title                String
  description          String
  theory               String?
  // level field removed per request
  showAdminScenarios   Boolean    @default(true)
  evaluationCriteria   Json?
  attachments          CourseAttachment[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  scenarios            Scenario[]
}

model CourseAttachment {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mime         String
  size         Int
  url          String
  createdAt    DateTime @default(now())
}

// Scenario practice models - linked directly to Course
model Scenario {
  id                  String              @id @default(uuid())
  title               String
  problemStatement    String
  coachingMaterials   String?
  // difficulty field removed per request
  courseId            String
  course              Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ownerId             String?
  owner               User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility          ScenarioVisibility  @default(PUBLIC)
  rubrics             Rubric[]
  responses           ScenarioResponse[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Rubric {
  id           String              @id @default(uuid())
  name         String              // "IMPACT", "FORMULARE FINALĂ", etc
  description  String              // Evaluation criteria
  scenarioId   String
  scenario     Scenario            @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scores       RubricScore[]
  createdAt    DateTime            @default(now())
}

model ScenarioResponse {
  id              String              @id @default(uuid())
  userId          String
  scenarioId      String
  response        String              // Student's answer
  aiEvaluation    String?             // AI-generated feedback
  overallScore    Int?                // 0-100
  isGraded        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario        Scenario            @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  rubricScores    RubricScore[]

  @@unique([userId, scenarioId])
}

model RubricScore {
  id                  String              @id @default(uuid())
  rubricId            String
  responseId          String
  score               Int                 // 0-100 per rubric
  feedback            String              // AI feedback for this rubric
  rubric              Rubric              @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  response           ScenarioResponse    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  
  @@unique([rubricId, responseId])
}
